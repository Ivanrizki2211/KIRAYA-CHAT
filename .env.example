NODE_ENV=development
NEXT_PUBLIC_APP_NAME="KIRAYA Chat"
NEXT_PUBLIC_APP_TAGLINE="Create Your Own Story"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

DATABASE_URL="postgresql://kiraya_user:change_me@localhost:5432/kiraya_chat"
SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

AI_PROVIDER="openai-compatible"
AI_BASE_URL="https://api.openai.com/v1"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
AI_ASSIST_MODEL="gpt-4o-mini"

VOICE_PROVIDER="none"
VOICE_API_KEY=""
VOICE_TTS_MODEL="gpt-4o-mini-tts"
VOICE_STT_MODEL="gpt-4o-transcribe"

STORAGE_ENDPOINT=""
STORAGE_BUCKET="kiraya-chat-media"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_PUBLIC_BASE_URL=""
